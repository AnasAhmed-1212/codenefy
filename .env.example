# Set the real public domain before a production build.
# Without this setting, indexing is disabled and the sitemap is empty.
NEXT_PUBLIC_SITE_URL=

# Verified business contact details. Empty values are not displayed.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# HTTPS endpoint that receives enquiry JSON and returns a 2xx response after
# accepting it. Until configured, submission is disabled on the contact page.
CONTACT_WEBHOOK_URL=

# Optional bearer token for the enquiry endpoint. Never expose this with NEXT_PUBLIC_.
CONTACT_WEBHOOK_SECRET=
